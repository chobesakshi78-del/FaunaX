# FAUNA-X Environment Configuration Template
# Copy to .env for local runtime or deployment

# Application Environment
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./faunax.db
# DATABASE_URL=postgresql+asyncpg://faunax_user:faunax_password@localhost:5432/faunax_db

# Redis Caching & Queue
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=faunax_production_secret_key_change_in_real_deployment_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration (Ultralytics / PyTorch)
MODEL_PATH=models/production/faunax_livestock_vision_v1.pt
MODEL_METADATA_PATH=models/production/model_metadata.json
CONFIDENCE_THRESHOLD=0.65
DEVICE=cuda

# Storage Path (Local file system for uploads)
UPLOAD_DIR=uploads

# Geospatial & Mapbox Token (Optional public token for vector basemaps)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiZmF1bmF4LWRlbW8iLCJhIjoiY2x4bXBsZTB4MDAwMDJ2MW14MG5vZzFweSJ9.demo
